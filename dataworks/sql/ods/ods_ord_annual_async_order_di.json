{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ECS_pft_business_case",
        "column": [
          "id",
          "consume_map",
          "card_mid",
          "sid",
          "terminal",
          "operId",
          "err_msg",
          "number",
          "status",
          "card_order_id",
          "options",
          "create_time"
        ],
        "connection": [
          {
            "datasource": "ECS_pft_business_case",
            "table": [
              "pft_annual_async_order"
            ]
          }
        ],
        "where": "`create_time` >= UNIX_TIMESTAMP(STR_TO_DATE('${bizdate}', '%Y%m%d')) AND `create_time` < UNIX_TIMESTAMP(DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY))",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_annual_async_order_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "consume_map",
          "card_mid",
          "sid",
          "terminal",
          "operid",
          "err_msg",
          "number",
          "status",
          "card_order_id",
          "options",
          "create_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
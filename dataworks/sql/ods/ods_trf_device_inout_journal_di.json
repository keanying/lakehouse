{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "pterminalmanager_data_middle_bi_batch",
        "column": [
          "id",
          "sid",
          "land_id",
          "site_id",
          "tid",
          "num",
          "device_key",
          "roll_type",
          "create_day",
          "create_time",
          "node_id"
        ],
        "connection": [
          {
            "datasource": "pterminalmanager_data_middle_bi_batch",
            "table": [
              "pft_device_inout_journal"
            ]
          }
        ],
        "where": "`create_time` >= STR_TO_DATE('${bizdate}', '%Y%m%d') AND `create_time` < DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY)",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_trf_device_inout_journal_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "sid",
          "land_id",
          "site_id",
          "tid",
          "num",
          "device_key",
          "roll_type",
          "create_day",
          "create_time",
          "node_id"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
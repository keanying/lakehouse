{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "BI_RDS_bi_datav",
        "column": [
          "order_channel_id",
          "track_source_id",
          "is_line_off",
          "is_group",
          "channel_name"
        ],
        "connection": [
          {
            "datasource": "BI_RDS_bi_datav",
            "table": [
              "dim_channel"
            ]
          }
        ],
        "where": "",
        "splitPk": "",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_channel_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "order_channel_id",
          "track_source_id",
          "is_line_off",
          "is_group",
          "channel_name"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
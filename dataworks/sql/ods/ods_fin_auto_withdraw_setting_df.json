{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "fid",
          "mode",
          "account_info",
          "freeze_type",
          "freeze_data",
          "service_fee",
          "cut_way",
          "close_date",
          "close_time",
          "transfer_date",
          "transfer_time",
          "cycle_mark",
          "status",
          "update_uid",
          "update_time"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "pft_auto_withdraw_setting"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_fin_auto_withdraw_setting_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "fid",
          "mode",
          "account_info",
          "freeze_type",
          "freeze_data",
          "service_fee",
          "cut_way",
          "close_date",
          "close_time",
          "transfer_date",
          "transfer_time",
          "cycle_mark",
          "status",
          "update_uid",
          "update_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
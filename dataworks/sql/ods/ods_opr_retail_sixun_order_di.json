{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "RDS_pft_open_cooperate",
        "column": [
          "id",
          "con_sys_bind",
          "member_id",
          "sync_create_time",
          "sync_update_time",
          "shop_code",
          "order_no",
          "status",
          "sale_money",
          "payment_money",
          "settlement_money",
          "table_number",
          "number_of_people",
          "pos_name",
          "operator",
          "create_time"
        ],
        "connection": [
          {
            "datasource": "RDS_pft_open_cooperate",
            "table": [
              "retail_sixun_order"
            ]
          }
        ],
        "where": "`sync_update_time` >= STR_TO_DATE('${bizdate}', '%Y%m%d') AND `sync_update_time` < DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY)",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_retail_sixun_order_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "con_sys_bind",
          "member_id",
          "sync_create_time",
          "sync_update_time",
          "shop_code",
          "order_no",
          "status",
          "sale_money",
          "payment_money",
          "settlement_money",
          "table_number",
          "number_of_people",
          "pos_name",
          "operator",
          "create_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }

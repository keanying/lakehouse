{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft002",
        "column": [
          "id",
          "fid",
          "account",
          "nick_name",
          "user_name",
          "appid",
          "service_type_info",
          "verify_type_info",
          "head_img",
          "qrcode_url",
          "isconnect",
          "func_info",
          "authorizer_refresh_token",
          "auth_type",
          "template_id",
          "applet_id",
          "chk_status",
          "create_time",
          "update_time"
        ],
        "connection": [
          {
            "datasource": "ecs_pft002",
            "table": [
              "pft_wx_open"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_trf_wx_open_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "fid",
          "account",
          "nick_name",
          "user_name",
          "appid",
          "service_type_info",
          "verify_type_info",
          "head_img",
          "qrcode_url",
          "isconnect",
          "func_info",
          "authorizer_refresh_token",
          "auth_type",
          "template_id",
          "applet_id",
          "chk_status",
          "create_time",
          "update_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
{bizdate} —— 只取当天新建记录，之后的状态变化漏采，已改为按 create_time
--   · 读端脱敏（明文不落数仓）：mobile：手机号：保留前 7 位号段（归属地），其余 SHA256；card_no：卡号 / 证件类：SHA256（仍可作关联键）
--   · 写入：truncate 当日分区（幂等，可重跑）；ORC + SNAPPY；脏数据 0 容忍（errorLimit=0），有脏数据直接失败告警
-- DataWorks 数据集成 · 脚本模式（JSON）：
-- ================================================================================================
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ECS_pft_business_case",
        "column": [
          "id",
          "date_time",
          "ordernum",
          "sid",
          "member_id",
          "operate_id",
          "CONCAT(LEFT(`mobile`, 7), '#', SHA2(`mobile`, 256))",
          "aio_card_id",
          "physical_principal",
          "physical_principal_balance",
          "physical_bonus",
          "physical_bonus_balance",
          "pay_type",
          "operation_type",
          "create_time",
          "money",
          "site_id",
          "channel",
          "CONCAT('#', SHA2(`card_no`, 256))",
          "wrist_id",
          "sub_merchant_id"
        ],
        "connection": [
          {
            "datasource": "ECS_pft_business_case",
            "table": [
              "pft_allinone_card_trades"
            ]
          }
        ],
        "where": "`create_time` >= UNIX_TIMESTAMP(STR_TO_DATE('${bizdate}', '%Y%m%d')) AND `create_time` < UNIX_TIMESTAMP(DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY))",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_allinone_card_trades_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "date_time",
          "ordernum",
          "sid",
          "member_id",
          "operate_id",
          "mobile",
          "aio_card_id",
          "physical_principal",
          "physical_principal_balance",
          "physical_bonus",
          "physical_bonus_balance",
          "pay_type",
          "operation_type",
          "create_time",
          "money",
          "site_id",
          "channel",
          "card_no",
          "wrist_id",
          "sub_merchant_id"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
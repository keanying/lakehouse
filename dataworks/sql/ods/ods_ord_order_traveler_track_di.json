{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "ordernum",
          "idx",
          "track_action",
          "tid",
          "tnum",
          "left_num",
          "source",
          "terminal",
          "branch_terminal",
          "saler_id",
          "insert_time",
          "oper_member",
          "msg",
          "ext_content",
          "order_time",
          "update_time",
          "order_month",
          "apply_did",
          "sync_state"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "pft_order_tourist_track"
            ]
          }
        ],
        "where": "`update_time` >= UNIX_TIMESTAMP(STR_TO_DATE('${bizdate}', '%Y%m%d')) AND `update_time` < UNIX_TIMESTAMP(DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY))",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_order_traveler_track_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "ordernum",
          "idx",
          "track_action",
          "tid",
          "tnum",
          "left_num",
          "source",
          "terminal",
          "branch_terminal",
          "saler_id",
          "insert_time",
          "oper_member",
          "msg",
          "ext_content",
          "order_time",
          "update_time",
          "order_month",
          "apply_did",
          "sync_state"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 8
    }
  }
}
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "pft_open",
        "column": [
          "id",
          "pftOrder",
          "apiOrder",
          "tempOrder",
          "request",
          "response",
          "ctime",
          "requestId"
        ],
        "connection": [
          {
            "datasource": "pft_open",
            "table": [
              "api_order_track"
            ]
          }
        ],
        "where": "ctime >= STR_TO_DATE(${ds}, '%Y%m%d') AND ctime <= DATE_ADD(STR_TO_DATE(${ds}, '%Y%m%d'), INTERVAL 1 DAY)",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_trf_api_order_track_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "pftorder",
          "apiorder",
          "temporder",
          "request",
          "response",
          "ctime",
          "requestid"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
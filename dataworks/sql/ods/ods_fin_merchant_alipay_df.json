{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft001",
        "column": [
          "memberid",
          "name",
          "appid",
          "app_auth_token",
          "app_refresh_token",
          "expires_in",
          "re_expires_in",
          "user_id",
          "created_at",
          "master_pid"
        ],
        "connection": [
          {
            "datasource": "ecs_pft001",
            "table": [
              "pft_merchant_alipay"
            ]
          }
        ],
        "where": "",
        "splitPk": "",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_fin_merchant_alipay_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "memberid",
          "name",
          "appid",
          "app_auth_token",
          "app_refresh_token",
          "expires_in",
          "re_expires_in",
          "user_id",
          "created_at",
          "master_pid"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
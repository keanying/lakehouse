{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft001",
        "column": [
          "id",
          "st_type",
          "CASE WHEN CHAR_LENGTH(`st_personid`) = 18 THEN CONCAT(LEFT(`st_personid`, 6), SUBSTR(`st_personid`, 7, 4), SUBSTR(`st_personid`, 17, 1), '#', SHA2(UPPER(`st_personid`), 256)) ELSE CONCAT('#', SHA2(UPPER(`st_personid`), 256)) END",
          "st_group",
          "st_status",
          "st_name",
          "st_memberid"
        ],
        "connection": [
          {
            "datasource": "ecs_pft001",
            "table": [
              "pft_staff"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_sup_staff_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "st_type",
          "st_personid",
          "st_group",
          "st_status",
          "st_name",
          "st_memberid"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
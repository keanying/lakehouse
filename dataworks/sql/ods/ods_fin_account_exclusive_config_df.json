{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "nums",
          "min_num",
          "max_num",
          "price",
          "unit_price",
          "discount",
          "valid_period",
          "purchase_type",
          "subject_code",
          "stat",
          "create_date",
          "update_date"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "pft_account_exclusive_config"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_fin_account_exclusive_config_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "nums",
          "min_num",
          "max_num",
          "price",
          "unit_price",
          "discount",
          "valid_period",
          "purchase_type",
          "subject_code",
          "stat",
          "create_date",
          "update_date"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
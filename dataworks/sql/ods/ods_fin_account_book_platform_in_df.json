        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "account_id",
          "subject_code",
          "subject_type",
          "template_code",
          "balance_money",
          "frozen_money",
          "settle_mark",
          "settle_id",
          "settle_income_money",
          "settle_payout_money",
          "trade_account_id",
          "trade_type",
          "trade_limit_money",
          "trade_limit_type",
          "trade_limit_total",
          "last_trade_id",
          "effect_time",
          "dead_time",
          "status",
          "add_time",
          "update_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {

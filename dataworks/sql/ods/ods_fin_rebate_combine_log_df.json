{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft001",
        "column": [
          "id",
          "sid",
          "fid",
          "rebate_date",
          "money",
          "final_money",
          "order_begin",
          "order_end",
          "account_type",
          "deal_type",
          "rebate_detail",
          "cycle",
          "status",
          "error",
          "rebate_time",
          "create_time"
        ],
        "connection": [
          {
            "datasource": "ecs_pft001",
            "table": [
              "pft_rebate_combine_log"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_fin_rebate_combine_log_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "sid",
          "fid",
          "rebate_date",
          "money",
          "final_money",
          "order_begin",
          "order_end",
          "account_type",
          "deal_type",
          "rebate_detail",
          "cycle",
          "status",
          "error",
          "rebate_time",
          "create_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_base_server",
        "column": [
          "id",
          "country_id",
          "level",
          "parent_code",
          "area_code",
          "area_name",
          "short_name",
          "join_name",
          "zip_code",
          "city_code",
          "lng",
          "lat",
          "status",
          "remark",
          "create_time",
          "create_by",
          "update_time",
          "update_by"
        ],
        "connection": [
          {
            "datasource": "POLAR_base_server",
            "table": [
              "region_area"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_region_area_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "country_id",
          "level",
          "parent_code",
          "area_code",
          "area_name",
          "short_name",
          "join_name",
          "zip_code",
          "city_code",
          "lng",
          "lat",
          "status",
          "remark",
          "create_time",
          "create_by",
          "update_time",
          "update_by"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
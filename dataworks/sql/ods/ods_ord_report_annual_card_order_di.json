{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "RDS_summary",
        "column": [
          "id",
          "date",
          "fid",
          "reseller_id",
          "lid",
          "tid",
          "pid",
          "level",
          "operate_id",
          "order_num",
          "order_ticket",
          "cost_money",
          "sale_money",
          "orders_info",
          "trade_type",
          "pay_way",
          "channel",
          "update_time",
          "site_id",
          "cancel_num",
          "cancel_ticket",
          "cancel_sale_money",
          "cancel_orders_info"
        ],
        "connection": [
          {
            "datasource": "RDS_summary",
            "table": [
              "pft_report_annual_card_order"
            ]
          }
        ],
        "where": "`update_time` >= UNIX_TIMESTAMP(STR_TO_DATE('${bizdate}', '%Y%m%d')) AND `update_time` < UNIX_TIMESTAMP(DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY))",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_report_annual_card_order_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "date",
          "fid",
          "reseller_id",
          "lid",
          "tid",
          "pid",
          "level",
          "operate_id",
          "order_num",
          "order_ticket",
          "cost_money",
          "sale_money",
          "orders_info",
          "trade_type",
          "pay_way",
          "channel",
          "update_time",
          "site_id",
          "cancel_num",
          "cancel_ticket",
          "cancel_sale_money",
          "cancel_orders_info"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_auth_center",
        "column": [
          "id",
          "tourist_id",
          "auth_apply_id",
          "identity_id",
          "end_time",
          "status",
          "auth_ext_content",
          "create_by",
          "update_by",
          "create_time",
          "update_time"
        ],
        "connection": [
          {
            "datasource": "POLAR_auth_center",
            "table": [
              "tourist_auth_info"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_cus_tourist_auth_info_df",

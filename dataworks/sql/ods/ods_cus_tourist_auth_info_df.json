        "writeMode": "truncate",
        "column": [
          "id",
          "tourist_id",
          "auth_apply_id",
          "identity_id",
          "end_time",
          "status",
          "auth_ext_content",
          "create_by",
          "update_by",
          "create_time",
          "update_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {

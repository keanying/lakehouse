{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ECS_pft_business_case",
        "column": [
          "id",
          "apply_did",
          "rule_name",
          "cover_url",
          "rule_state",
          "created_at",
          "updated_at",
          "deleted_at",
          "delete_flag"
        ],
        "connection": [
          {
            "datasource": "ECS_pft_business_case",
            "table": [
              "pft_annual_cover_rule"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_annual_cover_rule_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "apply_did",
          "rule_name",
          "cover_url",
          "rule_state",
          "created_at",
          "updated_at",
          "deleted_at",
          "delete_flag"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
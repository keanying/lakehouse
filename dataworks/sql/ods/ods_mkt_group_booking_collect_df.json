{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft002",
        "column": [
          "id",
          "mid",
          "group_id",
          "open_id",
          "group_price",
          "ordernum",
          "num",
          "create_time",
          "status",
          "openid",
          "relate_id"
        ],
        "connection": [
          {
            "datasource": "ecs_pft002",
            "table": [
              "pft_group_booking_collect"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_mkt_group_booking_collect_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "mid",
          "group_id",
          "open_id",
          "group_price",
          "ordernum",
          "num",
          "create_time",
          "status",
          "openid",
          "relate_id"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
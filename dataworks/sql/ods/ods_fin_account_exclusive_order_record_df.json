{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "orderid",
          "trade_no",
          "fid",
          "account_id",
          "subject_code",
          "memo",
          "trade_num",
          "remain_num",
          "opid",
          "trade_time",
          "template_item_code",
          "channel",
          "insert_time",
          "recmonth",
          "outter_trade_no",
          "h_config_id"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "pft_account_exclusive_order_record"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_fin_account_exclusive_order_record_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "orderid",
          "trade_no",
          "fid",
          "account_id",
          "subject_code",
          "memo",
          "trade_num",
          "remain_num",
          "opid",
          "trade_time",
          "template_item_code",
          "channel",
          "insert_time",
          "recmonth",
          "outter_trade_no",
          "h_config_id"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
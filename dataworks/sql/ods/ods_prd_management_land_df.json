{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "title",
          "letters",
          "jtype",
          "mtype",
          "municipality",
          "province",
          "address",
          "lng_lat_pos",
          "topic",
          "selling_point",
          "state",
          "operator_id",
          "create_time",
          "update_time",
          "oversea",
          "apply_did",
          "apply_time",
          "is_del",
          "CONCAT(LEFT(`tel`, 7), '#', SHA2(`tel`, 256))",
          "website",
          "runtime"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "pft_management_land"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_prd_management_land_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "title",
          "letters",
          "jtype",
          "mtype",
          "municipality",
          "province",
          "address",
          "lng_lat_pos",
          "topic",
          "selling_point",
          "state",
          "operator_id",
          "create_time",
          "update_time",
          "oversea",
          "apply_did",
          "apply_time",
          "is_del",
          "tel",
          "website",
          "runtime"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "RDS_pft_ai",
        "column": [
          "id",
          "scenic_id",
          "scenic_name",
          "period_granularity",
          "metric_level",
          "tag_value",
          "proportion",
          "tgi",
          "national_baseline",
          "ranking",
          "etl_time"
        ],
        "connection": [
          {
            "datasource": "RDS_pft_ai",
            "table": [
              "ads_scenic_customer_insight_wealth_consume_mo"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_cus_scenic_customer_insight_wealth_consume_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "scenic_id",
          "scenic_name",
          "period_granularity",
          "metric_level",
          "tag_value",
          "proportion",
          "tgi",
          "national_baseline",
          "ranking",
          "etl_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
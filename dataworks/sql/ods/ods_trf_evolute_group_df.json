{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "rds_distri_center",
        "column": [
          "id",
          "group_name",
          "group_type",
          "parent_group_id",
          "group_default",
          "operator_id",
          "sid",
          "rectime"
        ],
        "connection": [
          {
            "datasource": "rds_distri_center",
            "table": [
              "pft_evolute_group"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_trf_evolute_group_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "group_name",
          "group_type",
          "parent_group_id",
          "group_default",
          "operator_id",
          "sid",
          "rectime"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
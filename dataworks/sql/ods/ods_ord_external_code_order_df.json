{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ECS_pft_business_case",
        "column": [
          "id",
          "batch_id",
          "v_code",
          "ordernum",
          "send_time",
          "start_dt",
          "end_dt",
          "create_time",
          "update_time",
          "send_type",
          "state"
        ],
        "connection": [
          {
            "datasource": "ECS_pft_business_case",
            "table": [
              "pft_external_code_order"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_external_code_order_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "batch_id",
          "v_code",
          "ordernum",
          "send_time",
          "start_dt",
          "end_dt",
          "create_time",
          "update_time",
          "send_type",
          "state"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
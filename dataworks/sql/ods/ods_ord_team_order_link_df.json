{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "main_ordernum",
          "son_ordernum",
          "lid",
          "tid",
          "is_expired",
          "order_time",
          "active_status",
          "status",
          "update_time",
          "playtime"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "uu_ss_order_team_link"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_team_order_link_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "main_ordernum",
          "son_ordernum",
          "lid",
          "tid",
          "is_expired",
          "order_time",
          "active_status",
          "status",
          "update_time",
          "playtime"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
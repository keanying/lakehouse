{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "BI_RDS_bi_datav",
        "column": [
          "id",
          "pid",
          "shortname",
          "name",
          "merger_name",
          "merger_name_left",
          "province_name",
          "city_name",
          "country_name",
          "level",
          "pinyin",
          "code",
          "zip_code",
          "first",
          "lng",
          "lat"
        ],
        "connection": [
          {
            "datasource": "BI_RDS_bi_datav",
            "table": [
              "dim_hy_area"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_hy_area_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "pid",
          "shortname",
          "name",
          "merger_name",
          "merger_name_left",
          "province_name",
          "city_name",
          "country_name",
          "level",
          "pinyin",
          "code",
          "zip_code",
          "first",
          "lng",
          "lat"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft002",
        "column": [
          "id",
          "seckill_id",
          "job_id",
          "ordernum",
          "msg",
          "cycle_key",
          "tnum",
          "create_time",
          "is_new",
          "money",
          "sale_channel",
          "member_id",
          "tid",
          "activity_id",
          "play_time"
        ],
        "connection": [
          {
            "datasource": "ecs_pft002",
            "table": [
              "pft_seckill_log"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_mkt_seckill_log_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "seckill_id",
          "job_id",
          "ordernum",
          "msg",
          "cycle_key",
          "tnum",
          "create_time",
          "is_new",
          "money",
          "sale_channel",
          "member_id",
          "tid",
          "activity_id",
          "play_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "BI_RDS_pft_open_cooperate",
        "column": [
          "id",
          "con_sys_bind",
          "member_id",
          "sync_create_time",
          "sync_update_time",
          "shop_code",
          "shop_name",
          "shop_category"
        ],
        "connection": [
          {
            "datasource": "BI_RDS_pft_open_cooperate",
            "table": [
              "retail_sixun_shop"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_retail_sixun_shop_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "con_sys_bind",
          "member_id",
          "sync_create_time",
          "sync_update_time",
          "shop_code",
          "shop_name",
          "shop_category"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
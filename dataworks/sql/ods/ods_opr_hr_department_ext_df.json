        "datasource": "BI_RDS_oa_ecology",
        "column": [
          "id",
          "DEPTID",
          "BMFZR",
          "BMFGLD",
          "ZZJGBMFZR",
          "ZZJGBMFGLD",
          "JZGLBMFZR",
          "JZGLBMFGLD",
          "yjbq",
          "ejbq",
          "sjbq"
        ],

{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "vscreen_data_middle_bi_batch",
        "column": [
          "id",
          "name",
          "scenic",
          "scenic_id",
          "auth_key",
          "configuration",
          "flat",
          "created_at",
          "updated_at"
        ],
        "connection": [
          {
            "datasource": "vscreen_data_middle_bi_batch",
            "table": [
              "sbs_foundation_data"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_sbs_foundation_data_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "name",
          "scenic",
          "scenic_id",
          "auth_key",
          "configuration",
          "flat",
          "created_at",
          "updated_at"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
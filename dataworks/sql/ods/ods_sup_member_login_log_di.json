{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "pft_logging",
        "column": [
          "id",
          "mid",
          "login_ip",
          "login_source",
          "login_location",
          "login_browser",
          "login_os",
          "login_time"
        ],
        "connection": [
          {
            "datasource": "pft_logging",
            "table": [
              "pft_login_log"
            ]
          }
        ],
        "where": "login_time >= UNIX_TIMESTAMP(STR_TO_DATE(${ds}, '%Y%m%d'))\nAND login_time < UNIX_TIMESTAMP(DATE_ADD(STR_TO_DATE(${ds}, '%Y%m%d'), INTERVAL 1 DAY))",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_sup_member_login_log_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "mid",
          "login_ip",
          "login_source",
          "login_location",
          "login_browser",
          "login_os",
          "login_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
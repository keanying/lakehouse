{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ECS_pft_business_case",
        "column": [
          "id",
          "sid",
          "virtual_no",
          "CASE WHEN CHAR_LENGTH(`id_card_no`) = 18 THEN CONCAT(LEFT(`id_card_no`, 6), SUBSTR(`id_card_no`, 7, 4), SUBSTR(`id_card_no`, 17, 1), '#', SHA2(UPPER(`id_card_no`), 256)) ELSE CONCAT('#', SHA2(UPPER(`id_card_no`), 256)) END",
          "face_id",
          "status",
          "create_time",
          "update_time"
        ],
        "connection": [
          {
            "datasource": "ECS_pft_business_case",
            "table": [
              "pft_annual_aliface_map"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_annual_aliface_map_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "sid",
          "virtual_no",
          "id_card_no",
          "face_id",
          "status",
          "create_time",
          "update_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
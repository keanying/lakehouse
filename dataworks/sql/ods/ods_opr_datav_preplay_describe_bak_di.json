{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "BI_RDS_bi_datav",
        "column": [
          "member_id",
          "member_name",
          "stat_slice",
          "preplay_ticket_num",
          "checked_ticket_num",
          "booking_order_num",
          "nonchecked_ticket_num"
        ],
        "connection": [
          {
            "datasource": "BI_RDS_bi_datav",
            "table": [
              "datav_preplay_describe_bak"
            ]
          }
        ],
        "where": "stat_date = DATE_ADD(STR_TO_DATE(${ds}, '%Y%m%d'), interval -1 DAY)",
        "splitPk": "",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_datav_preplay_describe_bak_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "member_id",
          "member_name",
          "stat_slice",
          "preplay_ticket_num",
          "checked_ticket_num",
          "booking_order_num",
          "nonchecked_ticket_num"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
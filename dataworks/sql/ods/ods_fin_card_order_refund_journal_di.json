{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ECS_pft_business_case",
        "column": [
          "id",
          "pay_journal_id",
          "ordernum",
          "refund_order_num",
          "sid",
          "member_id",
          "operate_id",
          "balance_refund_money",
          "award_refund_money",
          "refund_money",
          "refund_status",
          "error_msg",
          "create_time"
        ],
        "connection": [
          {
            "datasource": "ECS_pft_business_case",
            "table": [
              "pft_card_order_refund_journal"
            ]
          }
        ],
        "where": "`create_time` >= UNIX_TIMESTAMP(STR_TO_DATE('${bizdate}', '%Y%m%d')) AND `create_time` < UNIX_TIMESTAMP(DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY))",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_fin_card_order_refund_journal_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "pay_journal_id",
          "ordernum",
          "refund_order_num",
          "sid",
          "member_id",
          "operate_id",
          "balance_refund_money",
          "award_refund_money",
          "refund_money",
          "refund_status",
          "error_msg",
          "create_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft002",
        "column": [
          "id",
          "mid",
          "aid",
          "sid",
          "cut_id",
          "cut_money",
          "cut_times",
          "ordernum",
          "begin",
          "end",
          "status",
          "error",
          "openid",
          "create_time",
          "update_time"
        ],
        "connection": [
          {
            "datasource": "ecs_pft002",
            "table": [
              "pft_cut_price_join"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_mkt_cut_price_join_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "mid",
          "aid",
          "sid",
          "cut_id",
          "cut_money",
          "cut_times",
          "ordernum",
          "begin",
          "end",
          "status",
          "error",
          "openid",
          "create_time",
          "update_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }

{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "orderid",
          "dstatus",
          "confirm_time",
          "confirm_op",
          "ifpack",
          "sysorder",
          "pack_order",
          "pack_process",
          "ifprint",
          "vcode",
          "tordernum",
          "partner_mark",
          "link_ordernum",
          "order_time",
          "update_time",
          "order_month",
          "apply_did",
          "sync_state"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "uu_order_addon"
            ]
          }
        ],
        "where": "`update_time` >= UNIX_TIMESTAMP(STR_TO_DATE('${bizdate}', '%Y%m%d')) AND `update_time` < UNIX_TIMESTAMP(DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY))",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_order_addon_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "orderid",
          "dstatus",
          "confirm_time",
          "confirm_op",
          "ifpack",
          "sysorder",
          "pack_order",
          "pack_process",
          "ifprint",
          "vcode",
          "tordernum",
          "partner_mark",
          "link_ordernum",
          "order_time",
          "update_time",
          "order_month",
          "apply_did",
          "sync_state"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "RDS_pft_ai",
        "column": [
          "id",
          "scenic_id",
          "scenic_name",
          "period_granularity",
          "metric_level",
          "ranking",
          "poi_name",
          "city",
          "popularity",
          "CONCAT(LEFT(`address`, 6), '****')",
          "etl_time"
        ],
        "connection": [
          {
            "datasource": "RDS_pft_ai",
            "table": [
              "ads_scenic_customer_insight_hot_visits_mo"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_cus_scenic_customer_insight_hot_visits_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "scenic_id",
          "scenic_name",
          "period_granularity",
          "metric_level",
          "ranking",
          "poi_name",
          "city",
          "popularity",
          "address",
          "etl_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
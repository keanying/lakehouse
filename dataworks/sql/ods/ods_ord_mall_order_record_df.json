{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft002",
        "column": [
          "id",
          "order_num",
          "member_id",
          "sid",
          "lid",
          "pid",
          "tid",
          "order_time",
          "ordertime",
          "order_status",
          "pay_status",
          "total_money",
          "activity_id",
          "activity_type",
          "is_all_dis",
          "quota"
        ],
        "connection": [
          {
            "datasource": "ecs_pft002",
            "table": [
              "pft_mall_order_record"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_mall_order_record_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "order_num",
          "member_id",
          "sid",
          "lid",
          "pid",
          "tid",
          "order_time",
          "ordertime",
          "order_status",
          "pay_status",
          "total_money",
          "activity_id",
          "activity_type",
          "is_all_dis",
          "quota"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
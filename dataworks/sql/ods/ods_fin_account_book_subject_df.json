{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "subject_code",
          "subject_name",
          "type",
          "unit",
          "can_withdraw",
          "can_invoice",
          "can_integral",
          "is_default",
          "priority",
          "repeatable",
          "refund_expires",
          "refund_limit",
          "remaining_limit",
          "third_party",
          "trade_type",
          "ext",
          "remark",
          "add_time",
          "update_time"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "pft_account_book_subject"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_fin_account_book_subject_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "subject_code",
          "subject_name",
          "type",
          "unit",
          "can_withdraw",
          "can_invoice",
          "can_integral",
          "is_default",
          "priority",
          "repeatable",
          "refund_expires",
          "refund_limit",
          "remaining_limit",
          "third_party",
          "trade_type",
          "ext",
          "remark",
          "add_time",
          "update_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
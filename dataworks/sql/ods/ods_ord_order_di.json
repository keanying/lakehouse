{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "member",
          "ordernum",
          "certnum",
          "remotenum",
          "lid",
          "tid",
          "pid",
          "aid",
          "tnum",
          "tprice",
          "ordername",
          "CONCAT(LEFT(`ordertel`, 7), '#', SHA2(`ordertel`, 256))",
          "CONCAT(LEFT(`contacttel`, 7), '#', SHA2(`contacttel`, 256))",
          "ordertime",
          "playtime",
          "begintime",
          "endtime",
          "ctime",
          "dtime",
          "status",
          "pay_status",
          "salerid",
          "remsg",
          "smserror",
          "paymode",
          "totalmoney",
          "ordermode",
          "onsale",
          "CASE WHEN CHAR_LENGTH(`personid`) = 18 THEN CONCAT(LEFT(`personid`, 6), SUBSTR(`personid`, 7, 4), SUBSTR(`personid`, 17, 1), '#', SHA2(UPPER(`personid`), 256)) ELSE CONCAT('#', SHA2(UPPER(`personid`), 256)) END",
          "callback",
          "code",
          "unionCheck",
          "visitors",
          "pay_time",
          "order_time",
          "update_time",
          "order_month",
          "product_type",
          "apply_did",
          "sync_state",
          "trade_order_id"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "uu_ss_order"
            ]
          }
        ],
        "where": "`update_time` >= UNIX_TIMESTAMP(STR_TO_DATE('${bizdate}', '%Y%m%d')) AND `update_time` < UNIX_TIMESTAMP(DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY))",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_order_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "member",
          "ordernum",
          "certnum",
          "remotenum",
          "lid",
          "tid",
          "pid",
          "aid",
          "tnum",
          "tprice",
          "ordername",
          "ordertel",
          "contacttel",
          "ordertime",
          "playtime",
          "begintime",
          "endtime",
          "ctime",
          "dtime",
          "status",
          "pay_status",
          "salerid",
          "remsg",
          "smserror",
          "paymode",
          "totalmoney",
          "ordermode",
          "onsale",
          "personid",
          "callback",
          "code",
          "unioncheck",
          "visitors",
          "pay_time",
          "order_time",
          "update_time",
          "order_month",
          "product_type",
          "apply_did",
          "sync_state",
          "trade_order_id"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 8
    }
  }
}
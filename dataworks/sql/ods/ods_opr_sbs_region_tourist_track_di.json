{ds}, '%Y%m%d')
 —— 只取当天新建记录，之后的状态变化漏采，已改为按 updated_at
--   · 写入：truncate 当日分区（幂等，可重跑）；ORC + SNAPPY；脏数据 0 容忍（errorLimit=0），有脏数据直接失败告警
-- DataWorks 数据集成 · 脚本模式（JSON）：
-- ================================================================================================
{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "vscreen_data_middle_bi_batch",
        "column": [
          "id",
          "scenic",
          "scenic_id",
          "region",
          "region_id",
          "tracks",
          "created_at",
          "updated_at"
        ],
        "connection": [
          {
            "datasource": "vscreen_data_middle_bi_batch",
            "table": [
              "sbs_region_tourist_track"
            ]
          }
        ],
        "where": "`updated_at` >= STR_TO_DATE('${bizdate}', '%Y%m%d') AND `updated_at` < DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY)",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_sbs_region_tourist_track_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "scenic",
          "scenic_id",
          "region",
          "region_id",
          "tracks",
          "created_at",
          "updated_at"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
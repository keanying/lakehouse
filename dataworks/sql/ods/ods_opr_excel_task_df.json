{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft001",
        "column": [
          "id",
          "fid",
          "member_id",
          "request",
          "hash",
          "send",
          "CONCAT(LEFT(`email`, 2), '***@', SUBSTRING_INDEX(`email`, '@', -1))",
          "del",
          "create_time",
          "update_time",
          "done",
          "msg",
          "download",
          "excel_type",
          "memo",
          "application_type",
          "encrypt_id",
          "first_head",
          "self_defined_structure",
          "file_name",
          "page_count",
          "template_code",
          "ext"
        ],
        "connection": [
          {
            "datasource": "ecs_pft001",
            "table": [
              "excel_task"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_excel_task_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "fid",
          "member_id",
          "request",
          "hash",
          "send",
          "email",
          "del",
          "create_time",
          "update_time",
          "done",
          "msg",
          "download",
          "excel_type",
          "memo",
          "application_type",
          "encrypt_id",
          "first_head",
          "self_defined_structure",
          "file_name",
          "page_count",
          "template_code",
          "ext"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
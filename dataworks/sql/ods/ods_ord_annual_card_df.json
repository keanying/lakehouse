{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ECS_pft_business_case",
        "column": [
          "id",
          "memberid",
          "sid",
          "pid",
          "virtual_no",
          "physics_no",
          "CONCAT('#', SHA2(`card_no`, 256))",
          "renew_times",
          "status",
          "create_time",
          "active_time",
          "sale_time",
          "update_time",
          "activate_source",
          "avalid_begin",
          "avalid_end",
          "distributor_id",
          "send_num",
          "dname",
          "CONCAT(LEFT(`mobile`, 7), '#', SHA2(`mobile`, 256))",
          "CASE WHEN CHAR_LENGTH(`id_card_no`) = 18 THEN CONCAT(LEFT(`id_card_no`, 6), SUBSTR(`id_card_no`, 7, 4), SUBSTR(`id_card_no`, 17, 1), '#', SHA2(UPPER(`id_card_no`), 256)) ELSE CONCAT('#', SHA2(UPPER(`id_card_no`), 256)) END",
          "province",
          "city",
          "CONCAT(LEFT(`address`, 6), '****')",
          "lock_type",
          "annual_status",
          "ext_info",
          "remarks"
        ],
        "connection": [
          {
            "datasource": "ECS_pft_business_case",
            "table": [
              "pft_annual_card"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_annual_card_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "memberid",
          "sid",
          "pid",
          "virtual_no",
          "physics_no",
          "card_no",
          "renew_times",
          "status",
          "create_time",
          "active_time",
          "sale_time",
          "update_time",
          "activate_source",
          "avalid_begin",
          "avalid_end",
          "distributor_id",
          "send_num",
          "dname",
          "mobile",
          "id_card_no",
          "province",
          "city",
          "address",
          "lock_type",
          "annual_status",
          "ext_info",
          "remarks"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
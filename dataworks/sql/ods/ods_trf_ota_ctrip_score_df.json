{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "RDS_pft_ai",
        "column": [
          "id",
          "account_id",
          "scenic_id",
          "evaluation_month",
          "region_id",
          "region_name",
          "region_type",
          "overall_service_score",
          "ocr_score",
          "fdr_score",
          "manual_intervention_rate_score",
          "timely_response_20s_score",
          "im_neg_rate_score",
          "collect_time",
          "create_time",
          "update_time"
        ],
        "connection": [
          {
            "datasource": "RDS_pft_ai",
            "table": [
              "ads_sup_ota_ctrip_score_di"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_trf_ota_ctrip_score_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "account_id",
          "scenic_id",
          "evaluation_month",
          "region_id",
          "region_name",
          "region_type",
          "overall_service_score",
          "ocr_score",
          "fdr_score",
          "manual_intervention_rate_score",
          "timely_response_20s_score",
          "im_neg_rate_score",
          "collect_time",
          "create_time",
          "update_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
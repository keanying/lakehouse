{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "mysql",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "ecs_pft001",
        "column": [
          "id",
          "package_log_id",
          "stop_type",
          "time_details",
          "contract_no",
          "sign_time",
          "repayment_record",
          "cooperation_mode",
          "open_type",
          "create_time",
          "update_time"
        ],
        "connection": [
          {
            "datasource": "ecs_pft001",
            "table": [
              "pft_module_package_log_ext"
            ]
          }
        ],
        "where": "",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_opr_module_package_log_ext_df",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "package_log_id",
          "stop_type",
          "time_details",
          "contract_no",
          "sign_time",
          "repayment_record",
          "cooperation_mode",
          "open_type",
          "create_time",
          "update_time"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}
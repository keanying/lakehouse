{
  "type": "job",
  "version": "2.0",
  "steps": [
    {
      "stepType": "polardb",
      "category": "reader",
      "name": "Reader",
      "parameter": {
        "datasource": "POLAR_myuu",
        "column": [
          "id",
          "ordernum",
          "ordername",
          "CONCAT(LEFT(`ordertel`, 7), '#', SHA2(`ordertel`, 256))",
          "CASE WHEN CHAR_LENGTH(`personid`) = 18 THEN CONCAT(LEFT(`personid`, 6), SUBSTR(`personid`, 7, 4), SUBSTR(`personid`, 17, 1), '#', SHA2(UPPER(`personid`), 256)) ELSE CONCAT('#', SHA2(UPPER(`personid`), 256)) END",
          "voucher_type",
          "create_time",
          "province_code",
          "city_code",
          "town_code",
          "CONCAT(LEFT(`address`, 6), '****')",
          "apply_did",
          "sync_state",
          "mobile_area",
          "mobile_region"
        ],
        "connection": [
          {
            "datasource": "POLAR_myuu",
            "table": [
              "order_user_info"
            ]
          }
        ],
        "where": "`create_time` >= UNIX_TIMESTAMP(STR_TO_DATE('${bizdate}', '%Y%m%d')) AND `create_time` < UNIX_TIMESTAMP(DATE_ADD(STR_TO_DATE('${bizdate}', '%Y%m%d'), INTERVAL 1 DAY))",
        "splitPk": "id",
        "encoding": "UTF-8"
      }
    },
    {
      "stepType": "hive",
      "category": "writer",
      "name": "Writer",
      "parameter": {
        "datasource": "BI_hive",
        "table": "ods.ods_ord_order_ticket_taker_di",
        "partition": "travel_date=${bizdate}",
        "writeMode": "truncate",
        "column": [
          "id",
          "ordernum",
          "ordername",
          "ordertel",
          "personid",
          "voucher_type",
          "create_time",
          "province_code",
          "city_code",
          "town_code",
          "address",
          "apply_did",
          "sync_state",
          "mobile_area",
          "mobile_region"
        ],
        "fileType": "orc",
        "compress": "SNAPPY"
      }
    }
  ],
  "order": {
    "hops": [
      {
        "from": "Reader",
        "to": "Writer"
      }
    ]
  },
  "setting": {
    "errorLimit": {
      "record": "0"
    },
    "speed": {
      "throttle": false,
      "concurrent": 2
    }
  }
}